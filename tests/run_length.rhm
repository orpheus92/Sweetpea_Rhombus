#lang rhombus
// Run-length constraints against ground truth.
//
// The oracle here counts run lengths directly off a finished sequence. It
// shares no code with cnf_of or holds_in, so it can referee both: for every
// case, the solver's output must equal the brute-force filter of all legal
// sequences, and the checker must accept exactly the same set.
import:
  "../sweetpea.rhm" open
  "../constraints.rhm" open
  "../synthesize.rhm" open

factor color: ["red", "blue"]
factor size:  ["small", "large"]
experiment plan:
  ~design: [color, size]
  ~cross: [color, size]

let S = "cryptominisat5"
fun report(label, ok): println((if ok | "  ok    " | "  FAIL  ") ++ label)

// ---------------------------------------------------------------- oracle
// The lengths of the maximal runs of `lvl` in column `col`.
fun runs_of(seq, col, lvl):
  fun go(i, cur, acc):
    let closed = if cur > 0 | acc ++ [cur] | acc
    cond
    | i == seq.length(): closed
    | seq[i][col] == lvl: go(i + 1, cur + 1, acc)
    | ~else: go(i + 1, 0, closed)
  go(0, 0, [])

fun all_of(lst, p):
  for values(ok = #true) (x in lst): ok && p(x)

// every run of every listed level satisfies ok_run
fun pred(col, lvls, ok_run):
  fun (s): all_of(lvls, fun (lvl): all_of(runs_of(s, col, lvl), ok_run))

let COLOR = 0
let SIZE = 1
let reds = ["red"]
let both_colors = ["red", "blue"]
let sizes = ["small", "large"]

// ------------------------------------------------------------- the design
let all_seqs = synthesize_trials(plan, 200, ~strategy: #'iterate, ~solver: S)
println("2 colors x 2 sizes = 4 trials; " ++ to_string(all_seqs.length())
          ++ " sequences satisfy the crossing\n")

// For each case: the solver under the constraint, the brute-force filter of
// all_seqs by the oracle, and the checker's verdict on both sides.
fun case(label, cons, p):
  let got = synthesize_trials(plan, 200, ~constraints: cons,
                              ~strategy: #'iterate, ~solver: S)
  let want = all_seqs.filter(~keep: p)
  let sat_sound = all_of(got, p)
  let chk_accepts = all_of(got, fun (s): check_sequence(plan, s, ~constraints: cons) == [])
  let chk_rejects:
    all_of(all_seqs.filter(~keep: fun (s): !p(s)),
           fun (s): check_sequence(plan, s, ~constraints: cons) != [])
  report(label ++ "  solver " ++ to_string(got.length())
           ++ " = brute force " ++ to_string(want.length()),
         got.length() == want.length() && sat_sound
           && chk_accepts && chk_rejects)

case("at_most_k_in_a_row(1, [color, \"red\"])  red never twice running   ",
     [at_most_k_in_a_row(1, [color, "red"])],
     pred(COLOR, reds, fun (r): r <= 1))

case("at_most_k_in_a_row(1, color)            no color twice running    ",
     [at_most_k_in_a_row(1, color)],
     pred(COLOR, both_colors, fun (r): r <= 1))

case("at_least_k_in_a_row(2, [color, \"red\"]) the two reds adjacent     ",
     [at_least_k_in_a_row(2, [color, "red"])],
     pred(COLOR, reds, fun (r): r >= 2))

case("exactly_k_in_a_row(2, [color, \"red\"])  one red run, length 2    ",
     [exactly_k_in_a_row(2, [color, "red"])],
     pred(COLOR, reds, fun (r): r == 2))

case("at_least_k_in_a_row(2, color)           both colors in blocks     ",
     [at_least_k_in_a_row(2, color)],
     pred(COLOR, both_colors, fun (r): r >= 2))

case("exactly_k_in_a_row(2, color)            RRBB or BBRR only         ",
     [exactly_k_in_a_row(2, color)],
     pred(COLOR, both_colors, fun (r): r == 2))

case("at_least_k_in_a_row(3, [color, \"red\"]) unsatisfiable: only 2 reds",
     [at_least_k_in_a_row(3, [color, "red"])],
     pred(COLOR, reds, fun (r): r >= 3))

case("exactly_k_in_a_row(1, size)             sizes strictly alternating",
     [exactly_k_in_a_row(1, size)],
     pred(SIZE, sizes, fun (r): r == 1))

case("at_most_k_in_a_row(1, color) + at_least_k_in_a_row(2, size)       ",
     [at_most_k_in_a_row(1, color), at_least_k_in_a_row(2, size)],
     fun (s): (pred(COLOR, both_colors, fun (r): r <= 1))(s)
                && (pred(SIZE, sizes, fun (r): r >= 2))(s))

// ------------------------------------------------- what the sequences are
println("\nexactly_k_in_a_row(2, color):")
for (s in synthesize_trials(plan, 10, ~constraints: [exactly_k_in_a_row(2, color)],
                            ~strategy: #'iterate, ~solver: S)):
  println("  " ++ to_string(for List (t in s): t[0]))
