#lang rhombus
import:
  rhombus/subprocess
  "sweetpea.rhm" open
  "constraints.rhm" open

export:
  synthesize_trials
  check_sequence
  count_sequences
  geometry_of
  numbering      // exposed so examples can show the encoding
  checker_for

// ------------------------------------------------------------------ util
fun product(ns :: List) :: Int:
  for values(acc = 1) (n in ns): acc * n
fun sum(ns :: List) :: Int:
  for values(acc = 0) (n in ns): acc + n
fun factorial(n :: Int) :: Int:
  if n <= 1 | 1 | n * factorial(n - 1)

fun combinations(counts :: List) :: List:
  match counts
  | []: [[]]
  | ~else:
      let tails = combinations(counts.drop(1))
      let nested:
        for List (i in 0..counts[0]):
          for List (t in tails): List.cons(i, t)
      List.append(& nested)

// --------------------------------------------------------------- geometry
fun geometry_of(exp :: Experiment) :: Geom:
  for (f in exp.design):
    when f.params != []
    | error("synthesize_trials: derived factors are not encoded yet: " ++ f.name)
  let counts = for List (f in exp.design): f.levels.length()
  // which design positions are crossed
  let cross_idx:
    for values(acc = []) (fi in 0..exp.design.length()):
      let nm = exp.design[fi].name
      let is_crossed:
        for values(o = #false) (c in exp.cross): o || c.name == nm
      if is_crossed | List.add(acc, fi) | acc
  when cross_idx.length() == 0
  | error("synthesize_trials: ~cross is empty")
  let cross_counts = for List (fi in cross_idx): counts[fi]
  let inner_trials = product(cross_counts)
  if !exp.within
  | Geom(inner_trials, exp.design, counts, combinations(cross_counts),
         cross_idx, inner_trials,
         for List (fi in 0..exp.design.length()): 1)
  | // the ~within factor joins the design at the end, held constant
    // across each instance of the inner block
    let facs = List.add(exp.design, exp.within)
    let cs = List.add(counts, exp.within.levels.length())
    let n_seg = exp.within.levels.length()
    let sustain:
      List.add(for List (fi in 0..exp.design.length()): 1, inner_trials)
    Geom(inner_trials * n_seg, facs, cs, combinations(cross_counts),
         cross_idx, inner_trials, sustain)

// Variable numbering. Lev atoms come first, then Comb atoms.
fun numbering(geom :: Geom):
  let width = sum(geom.counts)
  let base:
    for List (fi in 0..geom.factors.length()):
      sum(geom.counts.take(fi))
  let c_offset = geom.n_trials * width
  let n_combos = geom.combos.length()
  fun var_of(a):
    match a
    | Lev(i, fi, li): i * width + base[fi] + li + 1
    | Comb(i, j): c_offset + i * n_combos + j + 1
  values(var_of, c_offset + geom.n_trials * n_combos, width, base)

// The Comb variables are part of the encoding machinery, not a constraint:
// these clauses say c(i,j) is true exactly when trial i holds combination j.
// They are emitted once, like the variable allocation itself.
fun comb_definition(geom :: Geom, var_of) :: List:
  let nested:
    for List (i in 0..geom.n_trials):
      let per_j:
        for List (j in 0..geom.combos.length()):
          let combo = geom.combos[j]
          let negs:
            for List (k in 0..geom.cross_idx.length()):
              - var_of(Lev(i, geom.cross_idx[k], combo[k]))
          let forward = List.add(negs, var_of(Comb(i, j)))
          let backward:
            for List (k in 0..geom.cross_idx.length()):
              [- var_of(Comb(i, j)), var_of(Lev(i, geom.cross_idx[k], combo[k]))]
          List.cons(forward, backward)
      List.append(& per_j)
  List.append(& nested)

// Every constraint in play, built-ins first.
// The constraints every design gets, plus any the user supplied.
fun builtins(geom :: Geom, ~in_order: in_order = #false) :: List:
  let base = [consistent(), crossed()]
  let nested:
    for values(acc = base) (fi in 0..geom.factors.length()):
      if geom.sustain[fi] > 1
      | let f = geom.factors[fi]
        let core = acc ++ [sustained(f), outer_crossed(f)]
        if in_order | core ++ [sequential(f)] | core
      | acc
  nested

fun all_reqs(geom :: Geom, exp, extra :: List) :: List:
  let cs = builtins(geom, ~in_order: exp.in_order) ++ extra
  let nested:
    for List (c in cs):
      (c.reqs)(geom)
  List.append(& nested)

// --------------------------------------------------------------- DIMACS
fun write_cnf(geom, var_of, n_vars, reqs, blocking, path) :: Void:
  let from_reqs:
    let nested:
      for List (r in reqs): cnf_of(r, var_of)
    List.append(& nested)
  let all = comb_definition(geom, var_of) ++ from_reqs ++ blocking
  let out = Port.Output.open_file(path, ~exists: #'truncate)
  Port.Output.using out:
    println("p cnf " ++ to_string(n_vars) ++ " " ++ to_string(all.length()))
    for (cl in all):
      let line:
        for values(s = "") (v in cl): s ++ to_string(v) ++ " "
      println(line ++ "0")
  out.close()

fun read_all(path :: String) :: String:
  let ip = Port.Input.open_file(path)
  let s:
    for values(acc = "") (line in ip.lines()): acc ++ line ++ "\n"
  ip.close()
  s

fun solve(cnf_path :: String, solver :: String):
  when !subprocess.find_executable_path(solver)
  | error("synthesize_trials: solver not found on PATH: " ++ solver
            ++ "\n  install one with:  brew install cryptominisat"
            ++ "\n  or use ~strategy: #'random, which needs no solver")
  let out_path = cnf_path ++ ".out"
  let out = Port.Output.open_file(out_path, ~exists: #'truncate)
  let sp = subprocess.run(solver, ~out: out, ~err: #'pipe, cnf_path)
  sp.wait()
  out.close()
  let text = read_all(out_path)
  cond
  | text.contains("s UNSATISFIABLE"): #false
  | ~else:
      when !text.contains("s SATISFIABLE")
      | error("synthesize_trials: solver `" ++ solver
                ++ "` gave no recognisable answer:\n" ++ text)
      let v_lines = text.split("\n").filter(~keep: fun (l): l.length() > 0 && l[0] == Char"v")
      let toks:
        for values(acc = []) (l in v_lines): acc ++ l.split().drop(1)
      let model = toks.map(fun (t): String.to_int(t)).filter(~keep: fun (v): v && v != 0)
      when model.length() == 0
      | error("synthesize_trials: solver said SATISFIABLE but returned no model")
      model

// ------------------------------------------------------------- decoding
fun decode(geom :: Geom, var_of, model :: List) :: List:
  let truths = Set(& model.filter(~keep: fun (v): v > 0))
  for List (i in 0..geom.n_trials):
    for List (fi in 0..geom.factors.length()):
      let hits:
        for values(acc = []) (li in 0..geom.counts[fi]):
          if truths.contains(var_of(Lev(i, fi, li))) | List.add(acc, li) | acc
      when hits.length() != 1
      | error("decode: trial " ++ to_string(i) ++ ", factor "
                ++ geom.factors[fi].name ++ " has " ++ to_string(hits.length())
                ++ " levels set (expected 1)")
      geom.factors[fi].levels[hits[0]]

// ---------------------------------------------- checking, from the SAME reqs
// A sequence is a list of trials, each a list of level names.
fun checker_for(geom :: Geom, seq :: List):
  fun (a):
    match a
    | Lev(i, fi, li): seq[i][fi] == geom.factors[fi].levels[li]
    | Comb(i, j):
        let combo = geom.combos[j]
        for values(ok = #true) (k in 0..geom.cross_idx.length()):
          let fi = geom.cross_idx[k]
          ok && seq[i][fi] == geom.factors[fi].levels[combo[k]]

// Returns the names of the constraints the sequence violates ([] if sound).
fun check_sequence(exp :: Experiment, seq :: List,
                   ~constraints: extra :: List = []) :: List:
  let geom = geometry_of(exp)
  let is_set = checker_for(geom, seq)
  let cs = builtins(geom, ~in_order: exp.in_order) ++ extra
  let bad:
    for values(acc = []) (c in cs):
      let rs = (c.reqs)(geom)
      let ok:
        for values(o = #true) (r in rs): o && holds_in(r, is_set)
      if ok | acc | List.add(acc, c.name)
  bad

// -------------------------------------------------------------- strategies
fun gather(geom, var_of, n_vars, reqs, n, blocking, acc, solver, tmp):
  if n == 0
  | acc
  | write_cnf(geom, var_of, n_vars, reqs, blocking, tmp)
    let model = solve(tmp, solver)
    if model
    | let seq = decode(geom, var_of, model)
      let lev_vars:
        for values(a = []) (i in 0..geom.n_trials):
          for values(b = a) (fi in 0..geom.factors.length()):
            let li:
              for values(found = 0) (k in 0..geom.counts[fi]):
                if geom.factors[fi].levels[k] == seq[i][fi] | k | found
            List.add(b, var_of(Lev(i, fi, li)))
      let block = lev_vars.map(fun (v): - v)
      gather(geom, var_of, n_vars, reqs, n - 1,
             List.add(blocking, block), List.add(acc, seq), solver, tmp)
    | acc

fun shuffle(lst :: List) :: List:
  if lst.length() == 0
  | []
  | let i = math.random(lst.length())
    List.cons(lst[i], shuffle(lst.take(i) ++ lst.drop(i + 1)))

// Build a candidate sequence. Crossed factors get a fresh random ordering
// of the combinations within each segment; a sustained factor gets one level
// per segment (a random permutation of its levels); anything else in the
// design but not crossed gets an independent random level per trial.
fun propose(geom :: Geom) :: List:
  let n_seg = geom.n_trials / geom.seg_len
  let sustained_idx:
    for values(acc = []) (fi in 0..geom.factors.length()):
      if geom.sustain[fi] > 1 | List.add(acc, fi) | acc
  // one level per segment for each sustained factor
  let seg_levels:
    for List (fi in sustained_idx):
      shuffle(for List (li in 0..geom.counts[fi]): li)
  let nested:
    for List (s in 0..n_seg):
      let order = shuffle(geom.combos)
      for List (k in 0..geom.seg_len):
        let combo = order[k]
        for List (fi in 0..geom.factors.length()):
          let ci:
            for values(found = -1) (m in 0..geom.cross_idx.length()):
              if geom.cross_idx[m] == fi | m | found
          let si:
            for values(found = -1) (m in 0..sustained_idx.length()):
              if sustained_idx[m] == fi | m | found
          cond
          | ci >= 0: geom.factors[fi].levels[combo[ci]]
          | si >= 0: geom.factors[fi].levels[seg_levels[si][s]]
          | ~else: geom.factors[fi].levels[math.random(geom.counts[fi])]
  List.append(& nested)

fun sample_uniformly(exp, geom, extra, n, tries_left):
  if n == 0
  | []
  | if tries_left == 0
    | error("synthesize_trials: #\'random gave up after many rejections;"
              ++ " the constraints may be too tight for rejection sampling")
    | let cand = propose(geom)
      if check_sequence(exp, cand, ~constraints: extra) == []
      | List.cons(cand, sample_uniformly(exp, geom, extra, n - 1, 10000))
      | sample_uniformly(exp, geom, extra, n, tries_left - 1)

fun count_sequences(exp :: Experiment) :: Int:
  factorial(geometry_of(exp).n_trials)

// ---------------------------------------------------------------- public
fun synthesize_trials(exp :: Experiment,
                      count :: Int = 1,
                      ~constraints: extra :: List = [],
                      ~strategy: strategy :: Symbol = #'iterate,
                      ~solver: solver :: String = "cryptominisat5",
                      ~tmp: tmp :: String = "/tmp/sp_r.cnf") :: List:
  let geom = geometry_of(exp)
  let (var_of, n_vars, width, base) = numbering(geom)
  let reqs = all_reqs(geom, exp, extra)
  match strategy
  | #'iterate: gather(geom, var_of, n_vars, reqs, count, [], [], solver, tmp)
  | #'random: sample_uniformly(exp, geom, extra, count, 10000)
  | ~else: error("synthesize_trials: unknown ~strategy: " ++ to_string(strategy)
                   ++ "\n  known: #'iterate, #'random")
