#lang rhombus/and_meta

// A Rhombus front end for SweetPea experiment designs.
//
// Covers the `factor` and `experiment` forms from Figure 2 of the
// PESOSE/Rhombus proposal. No solver: this layer produces a design and
// checks it. Sampling stays in the Python SweetPea library.

export:
  Factor
  DerivedLevel
  Experiment
  factor
  experiment

class Factor(name, levels, params)
class DerivedLevel(name, arity, predicate)
class Experiment(name, design, cross, constraints, within, in_order)

meta:
  fun id_string(stx): to_string(Syntax.unwrap(stx))

defn.macro
// factor congruency(color, word):
//   [derived con(a, b): a == b,
//    derived inc(a, b): a != b]
| 'factor $name($fac, ...): [$lvl, ...]':
    let s = id_string(name)
    let arity = [fac, ...].length()
    let lvls:
      for List (l in [lvl, ...]):
        match l
        | 'derived $lname($p, ...): $body':
            let n = [p, ...].length()
            if n == arity
            | 'DerivedLevel($(id_string(lname)), $n, fun ($p, ...): $body)'
            | error("factor " +& s +& ": derived level `" +& id_string(lname)
                      +& "` takes " +& n +& " parameter(s), but " +& s
                      +& " is parameterized over " +& arity +& " factor(s)")
        | ~else:
            error("factor " +& s +& ": expected a `derived` clause")
    'def $name = Factor($s, [$(each lvls), ...], [$fac, ...])'

// factor color: ["red", "blue"]
| 'factor $name: $levels':
    'def $name = Factor($(id_string(name)), $levels, [])'

defn.macro
// experiment plan:
//   ~design: [color, word, congruency]
//   ~cross: [color, congruency]
//   ~constraints: [MinimumTrials(30)]
| 'experiment $name:
     ~design: [$d, ...]
     ~cross: [$c, ...]
     ~constraints: $cons':
    let s = id_string(name)
    let design_names = for List (f in [d, ...]): id_string(f)
    for (f in [c, ...]):
      when !(design_names.contains(id_string(f)))
      | error("experiment " +& s +& ": `" +& id_string(f)
                +& "` appears in ~cross but not in ~design")
    'def $name = Experiment($s, [$d, ...], [$c, ...], $cons, #false, #false)'

| 'experiment $name:
     ~design: [$d, ...]
     ~cross: [$c, ...]
     ~within: $w ~in_order
     ~constraints: $cons':
    let s = id_string(name)
    let design_names = for List (f in [d, ...]): id_string(f)
    for (f in [c, ...]):
      when !(design_names.contains(id_string(f)))
      | error("experiment " ++ s ++ ": `" ++ id_string(f)
                ++ "` appears in ~cross but not in ~design")
    'def $name = Experiment($s, [$d, ...], [$c, ...], $cons, $w, #true)'

| 'experiment $name:
     ~design: [$d, ...]
     ~cross: [$c, ...]
     ~within: $w ~in_order':
    'experiment $name:
       ~design: [$d, ...]
       ~cross: [$c, ...]
       ~within: $w ~in_order
       ~constraints: []'

| 'experiment $name:
     ~design: [$d, ...]
     ~cross: [$c, ...]
     ~within: $w
     ~constraints: $cons':
    let s = id_string(name)
    let design_names = for List (f in [d, ...]): id_string(f)
    for (f in [c, ...]):
      when !(design_names.contains(id_string(f)))
      | error("experiment " ++ s ++ ": `" ++ id_string(f)
                ++ "` appears in ~cross but not in ~design")
    when design_names.contains(id_string(w))
    | error("experiment " ++ s ++ ": `" ++ id_string(w)
              ++ "` is the ~within factor, so it must not also be in ~design")
    'def $name = Experiment($s, [$d, ...], [$c, ...], $cons, $w, #false)'

| 'experiment $name:
     ~design: [$d, ...]
     ~cross: [$c, ...]
     ~within: $w':
    'experiment $name:
       ~design: [$d, ...]
       ~cross: [$c, ...]
       ~within: $w
       ~constraints: []'

| 'experiment $name:
     ~design: [$d, ...]
     ~cross: [$c, ...]':
    'experiment $name:
       ~design: [$d, ...]
       ~cross: [$c, ...]
       ~constraints: []'
