#lang rhombus
// Run-length constraints: how long a level is allowed, or required, to
// persist. SweetPea spells these AtMostKInARow, AtLeastKInARow and
// ExactlyKInARow.
//
// Each takes either a whole factor -- the rule applies to every one of its
// levels -- or a single [factor, level] pair.
import:
  "../sweetpea.rhm" open
  "../constraints.rhm" open
  "../synthesize.rhm" open

factor color: ["red", "blue", "green"]
factor size:  ["small", "large"]
experiment plan:
  ~design: [color, size]
  ~cross: [color, size]

let S = "cryptominisat5"
fun colors(s): for List (t in s): t[0]
fun sizes(s): for List (t in s): t[1]

fun show(label, cons, column):
  println(label)
  let got = synthesize_trials(plan, 3, ~constraints: cons,
                              ~strategy: #'iterate, ~solver: S)
  if got.length() == 0
  | println("  no sequence satisfies this")
  | for (s in got):
      println("  " ++ to_string(column(s)))

println("6 trials: 3 colors x 2 sizes, so each color appears twice,")
println("each size three times. Only the column under discussion is shown,")
println("so two lines that look alike differ in the other factor.\n")

show("at_most_k_in_a_row(1, color)   -- no color twice running",
     [at_most_k_in_a_row(1, color)], colors)

show("\nat_least_k_in_a_row(2, color)   -- every color in one block of 2",
     [at_least_k_in_a_row(2, color)], colors)

show("\nat_least_k_in_a_row(2, [color, \"red\"])   -- only red must block up",
     [at_least_k_in_a_row(2, [color, "red"])], colors)

show("\nat_most_k_in_a_row(2, size)   -- a size may repeat, but not three times",
     [at_most_k_in_a_row(2, size)], sizes)

show("\nexactly_k_in_a_row(2, size)   -- impossible: each size appears three\n"
       ++ "                                 times, and 3 is not a multiple of 2",
     [exactly_k_in_a_row(2, size)], sizes)

show("\nat_least_k_in_a_row(3, [color, \"red\"])   -- red appears only twice",
     [at_least_k_in_a_row(3, [color, "red"])], colors)

// The same declaration also answers the question about a finished sequence.
// Nobody wrote a checker for these constraints; holds_in reads the same
// requirements the solver was given.
println("\nchecking a sequence that was not generated here:")
let hand = [["red", "small"], ["blue", "small"], ["red", "large"],
            ["blue", "large"], ["green", "small"], ["green", "large"]]
println("  " ++ to_string(colors(hand)))
for (c in [["at_most_k_in_a_row(2, color)", [at_most_k_in_a_row(2, color)]],
           ["at_least_k_in_a_row(2, color)", [at_least_k_in_a_row(2, color)]],
           ["exactly_k_in_a_row(2, [color, \"green\"])",
            [exactly_k_in_a_row(2, [color, "green"])]]]):
  let bad = check_sequence(plan, hand, ~constraints: c[1])
  println("  " ++ c[0] ++ " -> "
            ++ (if bad == [] | "satisfied" | to_string(bad)))
