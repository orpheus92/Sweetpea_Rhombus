#lang rhombus
// Levels referred to by name rather than by string.
//
// `factor color: ["red", "blue"]` binds the Factor and, inside its own
// namespace, each of its level names. So a constraint can say color.red,
// and color.pink does not compile:
//
//     $ raco make tests/bad-level.rhm
//     bad-level.rhm:21:65: pink: identifier not provided by color
//
// even when the constraint sits in a function nobody calls. The string form
// still works, because a level is a string at run time -- but "pink" can
// only be caught when the constraint runs, and only if it runs at all.
// This is the proposal's binding-versus-values argument, applied to levels.
import:
  "../sweetpea.rhm" open
  "../constraints.rhm" open
  "../synthesize.rhm" open

factor color: ["red", "blue"]
factor size:  ["small", "large"]
experiment plan:
  ~design: [color, size]
  ~cross: [color, size]

let S = "cryptominisat5"

println("a level name is an ordinary binding:")
println("  color.red            = " ++ to_string(color.red))
println("  color.blue           = " ++ to_string(color.blue))
println("  Factor.levels(color) = " ++ to_string(Factor.levels(color)))
println("")

// the two spellings mean the same thing to every constraint
fun count(cs):
  to_string(synthesize_trials(plan, 60, ~constraints: cs,
                              ~strategy: #'iterate, ~solver: S).length())

println("pin(0, color, color.red) -> " ++ count([pin(0, color, color.red)])
          ++ " sequences")
println("pin(0, color, \"red\")     -> " ++ count([pin(0, color, "red")])
          ++ " sequences")
println("")
println("exclude(color, color.red) -> " ++ count([exclude(color, color.red)])
          ++ " sequences, since the crossing needs red")
println("")
println("and in a run-length target, where the level sits in a pair:")
println("  at_least_k_in_a_row(2, [color, color.red]) -> "
          ++ count([at_least_k_in_a_row(2, [color, color.red])])
          ++ " sequences")

// A typo in the string form survives compilation and is caught only here,
// when the constraint is finally handed a geometry.
println("")
println("the string form, misspelled, reaches run time:")
let msg:
  try:
    count([exclude(color, "pink")])
    "no error"
    ~catch e:
      Exn.message(e)
println("  exclude(color, \"pink\") -> " ++ to_string(msg))
println("  exclude(color, color.pink) would not have compiled at all")
