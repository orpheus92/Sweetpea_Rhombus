#lang rhombus
import:
  "../sweetpea.rhm" open
  "../synthesize.rhm" open

factor color: ["red", "blue"]
factor size:  ["small", "large"]

experiment plan:
  ~design: [color, size]
  ~cross: [color, size]

let trials = synthesize_trials(plan, 3, ~solver: "cryptominisat5")
print_experiments(plan, trials)
