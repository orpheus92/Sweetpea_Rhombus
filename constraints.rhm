#lang rhombus/and_meta

// One declaration per constraint, two consumers.
//
// A constraint says, for a given design geometry, which *requirements* hold.
// Every requirement has the same shape: of this set of atoms, between `lo`
// and `hi` are true. There are two kinds of atom:
//
//   Lev(i, f, l)   trial i gives factor f its level l
//   Comb(i, j)     trial i realises combination j
//
// From that single description:
//   cnf_of    turns a requirement into clauses for the solver
//   holds_in  checks a requirement against a finished trial sequence
//
// Both are written once, here, and shared by every constraint. A constraint
// author writes neither an encoder nor a checker, so the two cannot drift
// apart -- which is exactly the bug that sat in SweetPea's Sequential, where
// constraint.py:1232 and :1487 had disagreed since May.

export:
  Lev
  Comb
  Not
  Req
  Geom
  Constraint
  exactly
  at_most
  at_least
  constraint
  cnf_of
  holds_in
  consistent
  crossed
  exclude
  pin
  no_repeats
  at_most_k_in_a_row
  at_least_k_in_a_row
  exactly_k_in_a_row
  exactly_k
  sustained
  outer_crossed
  sequential
  index_of_factor
  index_of_level

class Lev(trial, factor, level)
class Comb(trial, combo)
// A negated atom. Atoms are literals, so a requirement can say things like
// "at most one of (a, not b)", which is the clause (not a or b) -- an
// implication. Needed for sustain: a factor held constant over a segment.
class Not(atom)
class Req(atoms, lo, hi)
class Geom(n_trials, factors, counts, combos, cross_idx, seg_len, sustain)
class Constraint(name, reqs)

// Constraints name factors and levels directly; these resolve a name to
// the position the encoding uses. Writing `no_repeats(color)` rather than
// `no_repeats(0)` keeps a design readable and keeps index arithmetic out
// of user code.
fun index_of_factor(geom, f) :: Int:
  let i:
    for values(found = -1) (k in 0..geom.factors.length()):
      if geom.factors[k].name == f.name | k | found
  when i < 0
  | error("constraint: factor `" ++ f.name ++ "` is not in this design")
  i

fun index_of_level(geom, fi, lvl) :: Int:
  let i:
    for values(found = -1) (k in 0..geom.counts[fi]):
      if geom.factors[fi].levels[k] == lvl | k | found
  when i < 0
  | error("constraint: factor `" ++ geom.factors[fi].name
            ++ "` has no level " ++ to_string(lvl))
  i

fun exactly(n, atoms):  Req(atoms, n, n)
fun at_most(n, atoms):  Req(atoms, 0, n)
fun at_least(n, atoms): Req(atoms, n, atoms.length())

// `constraint name(args) ~given g: body`
// The body builds a list of Reqs. `g` names the design geometry; you choose
// the name, so there is no hygiene surprise.
defn.macro 'constraint $name($arg, ...) ~given $g: $body':
  let s = to_string(Syntax.unwrap(name))
  'def $name = fun ($arg, ...):
                 Constraint($s, fun ($g): $body)'

// ------------------------------------------------ the two shared consumers
fun lit_var(a, var_of):
  match a
  | Not(inner): - var_of(inner)
  | ~else: var_of(a)

fun lit_true(a, is_set):
  match a
  | Not(inner): !is_set(inner)
  | ~else: is_set(a)

fun pairwise_not_both(vs :: List) :: List:
  let n = vs.length()
  let nested:
    for List (a in 0..n):
      for List (b in (a+1)..n):
        [- vs[a], - vs[b]]
  List.append(& nested)

// At most k of `vs` are true, using the sequential counter encoding
// (Sinz 2005). s(i,j), numbered from `fresh`, means "at least j+1 of
// vs[0..i] are true". Needs (n-1)*k helper variables and O(n*k) clauses,
// where the naive encoding would need one clause per (k+1)-subset.
//
// Note that nothing in `holds_in` corresponds to any of this: checking
// still means counting. The encoder grew; the checker did not.
fun at_most_k(vs :: List, k :: Int, fresh :: Int):
  let n = vs.length()
  cond
  | k >= n: values([], fresh)
  | k == 0: values(vs.map(fun (v): [- v]), fresh)
  | k == 1: values(pairwise_not_both(vs), fresh)
  | ~else:
      fun sv(i, j): fresh + i * k + j
      let first:
        List.cons([- vs[0], sv(0, 0)],
                  for List (j in 1..k): [- sv(0, j)])
      let middle:
        let nested:
          for List (i in 1..(n-1)):
            let a = [[- vs[i], sv(i, 0)],
                     [- sv(i-1, 0), sv(i, 0)],
                     [- vs[i], - sv(i-1, k-1)]]
            let b:
              let inner:
                for List (j in 1..k):
                  [[- vs[i], - sv(i-1, j-1), sv(i, j)],
                   [- sv(i-1, j), sv(i, j)]]
              List.append(& inner)
            a ++ b
        List.append(& nested)
      let last = [[- vs[n-1], - sv(n-2, k-1)]]
      values(first ++ middle ++ last, fresh + (n-1) * k)

// At least k of `vs` are true == at most (n-k) of their negations are.
fun at_least_k(vs :: List, k :: Int, fresh :: Int):
  let n = vs.length()
  cond
  | k <= 0: values([], fresh)
  | k == 1: values([vs], fresh)
  | ~else: at_most_k(vs.map(fun (v): - v), n - k, fresh)

fun cnf_of(req :: Req, var_of, fresh :: Int):
  let vs = req.atoms.map(fun (a): lit_var(a, var_of))
  let (lo_cls, f1) = at_least_k(vs, req.lo, fresh)
  let (hi_cls, f2) = at_most_k(vs, req.hi, f1)
  values(lo_cls ++ hi_cls, f2)

fun holds_in(req :: Req, is_set) :: Boolean:
  let n:
    for values(acc = 0) (a in req.atoms):
      if lit_true(a, is_set) | acc + 1 | acc
  n >= req.lo && n <= req.hi

// ----------------------------------------------------- built-in constraints

// exactly one level of each factor on each trial
constraint consistent() ~given geom:
  let per:
    for List (i in 0..geom.n_trials):
      for List (fi in 0..geom.factors.length()):
        let atoms:
          for List (li in 0..geom.counts[fi]):
            Lev(i, fi, li)
        exactly(1, atoms)
  List.append(& per)

// every combination of the crossed factors appears exactly once,
// and each trial realises exactly one combination
// Every combination of the crossed factors appears exactly once *within
// each segment*. Without nesting there is one segment covering all trials,
// so this is the same as before; with `~within` each instance of the inner
// block is balanced on its own.
constraint crossed() ~given geom:
  let n_seg = geom.n_trials / geom.seg_len
  let per_combo:
    let nested:
      for List (s in 0..n_seg):
        for List (j in 0..geom.combos.length()):
          let atoms:
            for List (k in 0..geom.seg_len):
              Comb(s * geom.seg_len + k, j)
          exactly(1, atoms)
    List.append(& nested)
  let per_trial:
    for List (i in 0..geom.n_trials):
      let atoms:
        for List (j in 0..geom.combos.length()):
          Comb(i, j)
      exactly(1, atoms)
  per_combo ++ per_trial

// NOTE: a Comb atom names a combination of the CROSSED factors only.
// Factors that appear in ~design but not in ~cross are still subject to
// `consistent` -- one level per trial -- but are otherwise free.

// a level that must never appear
constraint exclude(f, lvl) ~given geom:
  let fi = index_of_factor(geom, f)
  let li = index_of_level(geom, fi, lvl)
  let atoms:
    for List (i in 0..geom.n_trials):
      Lev(i, fi, li)
  [at_most(0, atoms)]

// a level pinned to a particular trial
constraint pin(i, f, lvl) ~given geom:
  let fi = index_of_factor(geom, f)
  [at_least(1, [Lev(i, fi, index_of_level(geom, fi, lvl))])]

// No two consecutive trials share a level of factor `fi`.
// This is AtMostKInARow with k = 1: over each window of two adjacent
// trials, at most one carries the level. Note that nothing in cnf_of or
// holds_in changed to support it -- a window is just another set of atoms.
// A run-length constraint aims at either a whole factor -- every one of its
// levels -- or a single (factor, level) pair, written as a two-element list.
// SweetPea's AtMostKInARow takes the same two shapes; a Factor is not a List,
// so one `match` separates them.
fun target_levels(geom, target):
  match target
  | [f, lvl]:
      let fi = index_of_factor(geom, f)
      values(fi, [index_of_level(geom, fi, lvl)])
  | ~else:
      let fi = index_of_factor(geom, target)
      let all:
        for List (li in 0..geom.counts[fi]):
          li
      values(fi, all)

// No window of k+1 consecutive trials is entirely this level.
fun runs_at_most(geom, fi, li, k):
  for List (i in 0..(geom.n_trials - k)):
    let window:
      for List (d in 0..(k + 1)):
        Lev(i + d, fi, li)
    at_most(k, window)

// Wherever this level appears, its run is at least k long.
//
// A run starts at trial i when x_i holds and x_{i-1} does not, so "a run
// starting at i continues to i+j" is the clause
//   (not x_i) or x_{i-1} or x_{i+j}
// and a clause is just `at_least(1, ...)` over literals -- so this needs
// nothing new from cnf_of, and nothing at all from holds_in. A run with no
// room left before the end of the sequence is forbidden from starting.
fun runs_at_least(geom, fi, li, k):
  let n = geom.n_trials
  fun x(i): Lev(i, fi, li)
  let nested:
    for List (i in 0..n):
      // "a run starts at i" is (x_i and not x_{i-1}); at i = 0 it is just x_i
      let starts = if i == 0 | [Not(x(0))] | [Not(x(i)), x(i - 1)]
      if i + k <= n
      | for List (j in 1..k):
          at_least(1, starts ++ [x(i + j)])
      | [at_least(1, starts)]
  List.append(& nested)

fun over_targets(geom, target, per_level):
  let (fi, lis) = target_levels(geom, target)
  let nested:
    for List (li in lis):
      per_level(fi, li)
  List.append(& nested)

constraint at_most_k_in_a_row(k, target) ~given geom:
  over_targets(geom, target, fun (fi, li): runs_at_most(geom, fi, li, k))

constraint at_least_k_in_a_row(k, target) ~given geom:
  over_targets(geom, target, fun (fi, li): runs_at_least(geom, fi, li, k))

// Exactly k is at most k and at least k. Both halves are already declared,
// so this composes them rather than restating either.
constraint exactly_k_in_a_row(k, target) ~given geom:
  over_targets(geom, target,
               fun (fi, li):
                 runs_at_most(geom, fi, li, k)
                   ++ runs_at_least(geom, fi, li, k))

// AtMostKInARow with k = 1, kept because it reads better in a design.
constraint no_repeats(f) ~given geom:
  (at_most_k_in_a_row(1, f).reqs)(geom)

// A factor whose level is held constant across each segment. Expressed as
// an equivalence between the segment's first trial and each later one:
//   a -> b   is   at_most(1, [a, Not(b)])
// so an equivalence is two of those. No new machinery: cnf_of and holds_in
// handle it because atoms are literals.
constraint sustained(f) ~given geom:
  let fi = index_of_factor(geom, f)
  let n_seg = geom.n_trials / geom.seg_len
  let nested:
    for List (s in 0..n_seg):
      let first = s * geom.seg_len
      let per_k:
        for List (k in 1..geom.seg_len):
          let i = first + k
          let per_l:
            for List (li in 0..geom.counts[fi]):
              [at_most(1, [Lev(first, fi, li), Not(Lev(i, fi, li))]),
               at_most(1, [Lev(i, fi, li), Not(Lev(first, fi, li))])]
          List.append(& per_l)
      List.append(& per_k)
  List.append(& nested)

// Each level of the outer factor is used by exactly one segment.
constraint outer_crossed(f) ~given geom:
  let fi = index_of_factor(geom, f)
  let n_seg = geom.n_trials / geom.seg_len
  for List (li in 0..geom.counts[fi]):
    let atoms:
      for List (s in 0..n_seg):
        Lev(s * geom.seg_len, fi, li)
    exactly(1, atoms)

// The levels of a sustained factor appear in declaration order, one per
// segment, wrapping around. This is SweetPea's `Sequential`.
//
// Note what is NOT here: any statement of what a checker should verify.
// "segment s carries level s mod n" is written once. SweetPea wrote it
// twice -- constraint.py:1232 computes the segment index by dividing the
// trial index by the segment length, and :1487 forgot to divide -- and the
// two disagreed for months, with RandomGen silently returning the levels in
// the wrong order. That divergence has nowhere to live here.
constraint sequential(f) ~given geom:
  let fi = index_of_factor(geom, f)
  let n_seg = geom.n_trials / geom.seg_len
  let n = geom.counts[fi]
  for List (s in 0..n_seg):
    at_least(1, [Lev(s * geom.seg_len, fi, s mod n)])

// Exactly k trials carry this level. Needs the counter encoding for k >= 2;
// `holds_in` needed no change at all, because checking is still counting.
constraint exactly_k(k, f, lvl) ~given geom:
  let fi = index_of_factor(geom, f)
  let li = index_of_level(geom, fi, lvl)
  let atoms:
    for List (i in 0..geom.n_trials):
      Lev(i, fi, li)
  [exactly(k, atoms)]
